# Provider credentials live only in the parent server environment.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=gpt-5-mini
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GATEWAY_CUSTOM_BASE_URL=
GATEWAY_CUSTOM_API_KEY=

# Initial routes and the existing model-comparison page.
CANDIDATE_PROVIDER=azure
CANDIDATE_MODEL=gpt-5-mini
BASELINE_PROVIDER=azure
BASELINE_MODEL=gpt-5-mini

# Langfuse tracing and evaluations.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PROJECT_ID=
LANGFUSE_CAPTURE_CONTENT=true

# Local gateway limits.
GATEWAY_UPSTREAM_TIMEOUT_SECONDS=90
PARENT_MAX_REQUEST_BYTES=26214400
PARENT_PORT=5001
